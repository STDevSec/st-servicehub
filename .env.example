# =====================================================================
# ST ServiceHub — variables de entorno de EJEMPLO
# ---------------------------------------------------------------------
# - Copia este archivo a `.env` y completa los valores localmente.
# - `.env` está en .gitignore: NUNCA lo subas al repositorio.
# - Este archivo NO contiene secretos reales y solo usa marcadores.
# - Ninguna aplicación consume todavía estas variables: son una
#   propuesta inicial. Cada equipo las confirmará o ajustará al
#   implementar su servicio (y actualizará este archivo).
# =====================================================================

# --- Entorno general -------------------------------------------------
APP_ENV=local

# --- Puertos propuestos (pendientes de confirmación) -----------------
IDENTITY_SERVICE_PORT=8081
CLIENT_SERVICE_PORT=8082
TICKET_SERVICE_PORT=8083
PROJECT_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085
FRONTEND_PORT=4200

# --- Base de datos (motor pendiente de confirmación) -----------------
# Cada servicio tendrá su propia base de datos/esquema y sus propias
# credenciales. No compartas credenciales entre servicios.
IDENTITY_DB_URL=
IDENTITY_DB_USER=
IDENTITY_DB_PASSWORD=

CLIENT_DB_URL=
CLIENT_DB_USER=
CLIENT_DB_PASSWORD=

TICKET_DB_URL=
TICKET_DB_USER=
TICKET_DB_PASSWORD=

# --- Seguridad --------------------------------------------------------
# Secreto/clave para firmar tokens. Genera uno propio y largo en local,
# p. ej.: openssl rand -base64 48
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_MINUTES=60
