# Normaliza finales de línea: LF en el repositorio para todo archivo de texto.
* text=auto eol=lf

# Scripts de Windows requieren CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Scripts de shell siempre LF (si no, fallan en contenedores Linux).
*.sh  text eol=lf
mvnw  text eol=lf

# Binarios: sin normalización ni diff textual.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.jar  binary
*.zip  binary
*.gz   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary

# Archivos generados: se colapsan en las vistas de diff de GitHub.
package-lock.json linguist-generated=true -diff
